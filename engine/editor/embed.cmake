# cmake -DOUT=<file.cpp> -DFILES="<name>=<path>|..." -P embed.cmake: each file as a byte array,
# `const unsigned char <name>[]` with `const unsigned int <name>_size`.
set(code "// Generated by embed.cmake.\n")
string(REPLACE "|" ";" entries "${FILES}")
foreach(entry ${entries})
	string(REPLACE "=" ";" parts "${entry}")
	list(GET parts 0 name)
	list(GET parts 1 path)
	file(READ "${path}" hex HEX)
	string(LENGTH "${hex}" n)
	math(EXPR size "${n} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(APPEND code "extern const unsigned char ${name}[] = {${bytes}};\nextern const unsigned int ${name}_size = ${size};\n")
endforeach()
file(WRITE "${OUT}" "${code}")
