// Windows resources for Battlegrounds.exe: manifest and version information. launcher_version.h
// is generated from OPENBG_VERSION and OPENBG_BUILD_NUMBER (see launcher/cmake/CMakeLists.txt).
#include <winver.h>
#include <winuser.h>
#include "launcher_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OPENBG_VERSION_COMMA
PRODUCTVERSION OPENBG_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "openomf-battlegrounds contributors"
      VALUE "FileDescription", "One Must Fall: Battlegrounds launcher"
      VALUE "FileVersion", OPENBG_VERSION_TEXT
      VALUE "InternalName", "Battlegrounds"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "Battlegrounds.exe"
      VALUE "ProductName", "openomf-battlegrounds"
      VALUE "ProductVersion", OPENBG_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
