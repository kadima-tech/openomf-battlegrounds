# Full game installs and analysis artifacts stay local. The cumulative update
# under launcher/patches is intentionally versioned for offline app packaging.
/source/
/re/*
!/re/FINDINGS.md
!/re/opcodes.md
!/re/scripts/
!/re/proto/
/re/proto/__pycache__/

engine/build*/
/launcher/build/
/launcher/patches/*.part
/dist/
__pycache__/
.DS_Store
.claude/worktrees/
/tools/*/build*/

# Mods: built add-ons hold copies of game objects; references are third-party art and text.
/mods/*/build/
/mods/*/references/
